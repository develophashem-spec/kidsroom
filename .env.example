# Copy this file to `.env.local` and adjust the values.

# --- Database -----------------------------------------------------------------
# MongoDB connection string. Required in production.
# `docker compose up -d` starts a local MongoDB that matches this default.
MONGODB_URI=mongodb://127.0.0.1:27017/thefit

# Used only by `npm run test:integration`. The database name MUST end with `_test`
# because the tests drop it.
TEST_MONGODB_URI=mongodb://127.0.0.1:27017/thefit_test

# --- Authentication -----------------------------------------------------------
# Secret used to sign session cookies. Required in production (min 32 characters).
# Generate one with: openssl rand -base64 48
AUTH_SECRET=

# --- Seed data (`npm run seed`) -----------------------------------------------
# Admin account created by the seed script. Change these before deploying!
SEED_ADMIN_EMAIL=admin@thefit.test
SEED_ADMIN_PASSWORD=ChangeMe123!

# --- Storefront (optional, inlined at build time) -----------------------------
NEXT_PUBLIC_STORE_NAME="The Fit Store"
NEXT_PUBLIC_CURRENCY=USD
NEXT_PUBLIC_LOCALE=en-US
# Flat shipping fee and free-shipping threshold, in minor units (cents).
NEXT_PUBLIC_SHIPPING_FLAT_CENTS=800
NEXT_PUBLIC_FREE_SHIPPING_CENTS=10000
